<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net7.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- NuGet Package Properties -->
    <PackageId>MZ.Logging.Configuration</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nuno Cancelo</Authors>
    <Description>Configuration providers for MZ.Logging.AzureTableStorage - supports Azure App Settings, Azure App Configuration, and Azure Key Vault</Description>
    <PackageProjectUrl>https://github.com/masterzdran/mz-logging-azure-tablestorage-csharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/masterzdran/mz-logging-azure-tablestorage-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>logging;azure;configuration;app-configuration;key-vault;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MZ.Logging.AzureTableStorage\MZ.Logging.AzureTableStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <PackageReference Include="Azure.Data.AppConfiguration" Version="1.4.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.5.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="6.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
